%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!13 &1
InputManager:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Axes:
  - serializedVersion: 3
    m_Name: Horizontal
    negativeButton: left
    positiveButton: right
    altNegativeButton: a
    altPositiveButton: d
    gravity: 3
    dead: 0.001
    sensitivity: 3
    snap: 1
    type: 0
    axis: 0
    joyNum: 0

  - serializedVersion: 3
    m_Name: Vertical
    negativeButton: down
    positiveButton: up
    altNegativeButton: s
    altPositiveButton: w
    gravity: 3
    dead: 0.001
    sensitivity: 3
    snap: 1
    type: 0
    axis: 0
    joyNum: 0

  - serializedVersion: 3
    m_Name: Fire1
    positiveButton: left ctrl
    altPositiveButton: mouse 0
    gravity: 1000
    dead: 0.001
    sensitivity: 1000
    type: 0
    axis: 0
    joyNum: 0

  - serializedVersion: 3
    m_Name: Fire2
    positiveButton: left alt
    altPositiveButton: mouse 1
    gravity: 1000
    dead: 0.001
    sensitivity: 1000
    type: 0
    axis: 0
    joyNum: 0

  - serializedVersion: 3
    m_Name: Fire3
    positiveButton: left shift
    altPositiveButton: mouse 2
    gravity: 1000
    dead: 0.001
    sensitivity: 1000
    type: 0
    axis: 0
    joyNum: 0

  - serializedVersion: 3
    m_Name: Jump
    positiveButton: space
    gravity: 1000
    dead: 0.001
    sensitivity: 1000
    type: 0
    axis: 0
    joyNum: 0

  - serializedVersion: 3
    m_Name: Mouse X
    gravity: 0
    dead: 0
    sensitivity: 0.1
    type: 1
    axis: 0
    joyNum: 0

  - serializedVersion: 3
    m_Name: Mouse Y
    gravity: 0
    dead: 0
    sensitivity: 0.1
    type: 1
    axis: 1
    joyNum: 0

  - serializedVersion: 3
    m_Name: Mouse ScrollWheel
    gravity: 0
    dead: 0
    sensitivity: 0.1
    type: 1
    axis: 2
    joyNum: 0

  - serializedVersion: 3
    m_Name: Submit
    positiveButton: return
    altPositiveButton: joystick button 0
    gravity: 1000
    dead: 0.001
    sensitivity: 1000
    type: 0
    axis: 0
    joyNum: 0

  - serializedVersion: 3
    m_Name: Cancel
    positiveButton: escape
    altPositiveButton: joystick button 1
    gravity: 1000
    dead: 0.001
    sensitivity: 1000
    type: 0
    axis: 0
    joyNum: 0

  m_UsePhysicalKeys: 1